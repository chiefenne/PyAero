<!--
   The XML structure in this file allows for a dynamic toolbar population in PyAero
   If new toolbar items are added, there need to be written respective handlers (PyQt slots)
   or existing functions can be called.
-->
<PyAero>
    <Toolbar name='Toolbar'>
        <Tool tip='Open airfoil contour file' icon='open' handler='onOpen'></Tool>
        <Tool tip='Save airfoil contour file' icon='save' handler='onSave'></Tool>
        <Tool tip='' icon='' handler='onPass'></Tool>
        <Tool tip='Print current view' icon='print' handler='onPrint'></Tool>
        <Tool tip='Print preview' icon='print-preview' handler='onPreview'></Tool>
        <Tool tip='' icon='' handler='onPass'></Tool>
        <Tool tip='Open predefined airfoil contour' icon='airfoil-library' handler='onOpenPredefined'></Tool>
        <Tool tip='' icon='' handler='onPass'></Tool>
        <Tool tip='Delete selected airfoil(s)' icon='delete' handler='removeAirfoil'></Tool>
        <Tool tip='' icon='' handler='onPass'></Tool>
        <Tool tip='Fit airfoil in view' icon='fit-airfoil' handler='fitAirfoilInView'></Tool>
        <Tool tip='Fit all in view' icon='fit-all' handler='onViewAll'></Tool>
        <Tool tip='' icon='' handler='onPass'></Tool>
        <Tool tip='Autorun (for testing)' icon='autorun' handler='runCommands'></Tool>
        <Tool tip='' icon='' handler='onPass'></Tool>
        <Tool tip='About' icon='about' handler='onAbout'></Tool>
        <Tool tip='' icon='' handler='onPass'></Tool>
        <Tool tip='Shut down PyAero' icon='exit' handler='onExit'></Tool>
    </Toolbar>
</PyAero>
